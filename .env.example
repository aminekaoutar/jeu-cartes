# Copy this file to .env and fill in real values before running
# `docker compose up --build`. Never commit the real .env file.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (service: db) ---
POSTGRES_DB=blackjack
POSTGRES_USER=blackjack
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis (service: cache) ---
# Overridden automatically to redis://cache:6379/0 inside docker-compose;
# only needed here for running the app outside of Docker.
REDIS_URL=redis://localhost:6379/0
